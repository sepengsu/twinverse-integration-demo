# Optional file selection
# SUPER_AGENT_CONFIG_FILE=config/agents.yaml
# SUPER_AGENT_ENV_FILE=.env

# Convenient endpoint aliases
SKKU_AGENT_URL=http://127.0.0.1:9001
SKKU_AGENT_HOST=127.0.0.1
SKKU_AGENT_PORT=9001
TWINVERSE_MCP_URL=http://127.0.0.1:8000/mcp
TWINVERSE_MCP_TIMEOUT_SECONDS=60
CAU_AGENT_URL=http://127.0.0.1:9002
CAU_AGENT_HOST=127.0.0.1
CAU_AGENT_PORT=9002

# Twinverse-compatible supervisor LLM settings
# Same env names as twinverse-mcp-client.
SUPERVISOR_AGENT_MODEL="openrouter:gemini-3-flash-preview"
SUPERVISOR_AGENT_KWARGS='{"reasoning_effort":"minimal"}'

# Provider API keys are read by the provider/client layer when an LLM planner is enabled.
# Keep real keys only in your local .env or OS environment, never in committed files.
# OPENROUTER_API_KEY=...
# OPENAI_API_KEY=...

# Generic nested overrides (SUPER_AGENT_ + YAML path joined with __)
# SUPER_AGENT_ENVIRONMENT=production
# SUPER_AGENT_SUPERVISOR__HOST=0.0.0.0
# SUPER_AGENT_SUPERVISOR__PORT=9000
# SUPER_AGENT_SUPERVISOR__REQUEST_TIMEOUT_SECONDS=60
# SUPER_AGENT_LLM__SUPERVISOR_AGENT_MODEL=openrouter:gemini-3-flash-preview
# SUPER_AGENT_LLM__SUPERVISOR_AGENT_KWARGS='{"reasoning_effort":"minimal"}'
# SUPER_AGENT_AGENTS__SKKU_ROBOT__ENABLED=true
# SUPER_AGENT_AGENTS__SKKU_ROBOT__MCP__TIMEOUT_SECONDS=60
# SUPER_AGENT_AGENTS__CAU_PROCESS__ENABLED=true
# SUPER_AGENT_AGENTS__CAU_PROCESS__A2A__STREAMING=false
